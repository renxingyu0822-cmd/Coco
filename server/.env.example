# template for server/.env — copy it to .env and put your real key there.
# .env is git-ignored, this example file is not (so no real key here!)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# voice (optional, these are the defaults)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_LANGUAGE=en
