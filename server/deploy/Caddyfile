# ─────────────────────────────────────────────────────────────
# Caddyfile — the HTTPS front door of the online server
#
# Lives on the server at /etc/caddy/Caddyfile
# Caddy gets + renews the HTTPS certificate by itself (Let's Encrypt)
# and passes requests on to Coco inside the server (127.0.0.1:8000).
#
# Address: sslip.io is a free name that points to the IP inside it
# (65-108-248-13.sslip.io -> 65.108.248.13). Own domain maybe later.
#
# Everything goes through; Coco checks the app password herself
# (server/app/auth.py) on /chat, /speak, /transcribe.
#
# After editing (on the server):  systemctl reload caddy
# ─────────────────────────────────────────────────────────────

65-108-248-13.sslip.io {
	reverse_proxy 127.0.0.1:8000
}
